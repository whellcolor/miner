# ===========================
# RPC URL (Sepolia Testnet)
# Bisa pakai Infura, Alchemy, atau public node
# ===========================
RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID"

# ===========================
# Private key deployer wallet
# Wallet default: 0xd8519a8b8825aa0dcc73aad572f447fae102fe88
# ===========================
PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# ===========================
# Optional: reward amount default (in wei)
# ===========================
REWARD_AMOUNT="900000000000000000"  # 0.9 ETH
